{
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "spago bundle --bundle-type app --outfile dist/app.js && cp -r public/. dist/ && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "build:purs": "spago bundle --bundle-type app --outfile dist/app.js",
    "watch:css": "tailwindcss -i src/styles.css -o dist/styles.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "esbuild": "^0.27.3",
    "purescript": "^0.15.15",
    "spago": "^1.0.3",
    "tailwindcss": "^4.1.18"
  }
}
